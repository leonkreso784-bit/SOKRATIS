{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sokratis",
  "identifier": "dev.sokratis.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sokratis",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "visible": false
      },
      {
        "label": "splash",
        "url": "splash.html",
        "width": 640,
        "height": 358,
        "decorations": false,
        "resizable": false,
        "center": true,
        "alwaysOnTop": true,
        "visible": true,
        "skipTaskbar": true,
        "backgroundColor": "#0b1017"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
